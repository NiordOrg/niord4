  {
    "mailingListId": "navwarn-update",
    "active": false,
    "descs": [
      {
        "lang": "da",
        "name": "Navwarn opdateringer",
        "description": "Mailliste for danske navigationsadvarsler"
      },
      {
        "lang": "en",
        "name": "Navwarn updates",
        "description": "Mailing list for Danish coastal warnings"
      }
    ],
    "triggers": [
      {
        "type": "STATUS_CHANGE",
        "statusChanges": [
          "CANCELLED"
        ],
        "messageFilter": "msg.messageSeries.seriesId == 'dma-nw' && msg.type == 'COASTAL_WARNING'",
        "scriptResourcePaths": [
          "templates/mailinglist/cancel-navwarn.ftl"
        ],
        "descs": [
          {
            "lang": "da",
            "subject": "Annullér Dansk navigationsadvarsel ${short-id}"
          },
          {
            "lang": "en",
            "subject": "Cancel Danish Navigational Warning ${short-id}"
          }
        ]
      },
      {
        "type": "STATUS_CHANGE",
        "statusChanges": [
          "PUBLISHED"
        ],
        "messageFilter": "msg.messageSeries.seriesId == 'dma-nw' && msg.type == 'COASTAL_WARNING'",
        "scriptResourcePaths": [
          "templates/mailinglist/publish-navwarn.ftl"
        ],
        "descs": [
          {
            "lang": "da",
            "subject": "Dansk navigationsadvarsel ${short-id}"
