<job id="repo-import" xmlns="http://xmlns.jcp.org/xml/ns/javaee" version="1.0">
    <listeners>
        <listener ref="batchJobListener"/>
    </listeners>
    <step id="importRepoFilesStep">
        <chunk item-count="50">
            <reader ref="batchRepoImportReader" />
            <processor ref="batchRepoImportProcessor"/>
            <writer ref="batchRepoImportWriter" />
        </chunk>
    </step>
</job>
