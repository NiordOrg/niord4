<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.niord</groupId>
        <artifactId>niord-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- The base product's bootstrap, published as org.niord:niord-bootstrap:<version>:zip
         (docs/code-data-config-plan.md §7.1): the folder niord/bootstrap/ zipped as it is (README.md,
         batch-set.json, the data files, texts.json, templates/ and releases/). It is data, not code, so
         it is in no jar or image: a fresh deployment gets it through the bootstrap command
         (be/scripts/bootstrap.sh), and a country's pipeline applies the pinned version's zip before its
         own. The module has no sources; it exists so that publish.yml's deploy, which deploys
         niord-parent and niord-base, deploys this zip and its pom beside them under the same version. -->
    <artifactId>niord-bootstrap</artifactId>
    <packaging>pom</packaging>
    <name>Niord bootstrap</name>

    <properties>
        <!-- No country build group: the module has no tests. -->
        <niord.countryGroup.skip>true</niord.countryGroup.skip>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <executions>
                    <execution>
                        <id>bootstrap-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <descriptors>
                                <descriptor>src/assembly/bootstrap.xml</descriptor>
                            </descriptors>
                            <finalName>niord-bootstrap-${project.version}</finalName>
                            <appendAssemblyId>false</appendAssemblyId>
                            <!-- Attached below with type zip and no classifier: the assembly plugin
                                 would attach a pom-packaged module's zip as its main artifact. -->
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-bootstrap-zip</id>
                        <phase>package</phase>
                        <goals>
                            <goal>attach-artifact</goal>
                        </goals>
                        <configuration>
                            <artifacts>
                                <artifact>
                                    <file>${project.build.directory}/niord-bootstrap-${project.version}.zip</file>
                                    <type>zip</type>
                                </artifact>
                            </artifacts>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
