# typescript-eslint@8.56.1 declares a peer range of `typescript >=4.8.4 <6.0.0`,
# but the project runs TypeScript 6. The mismatch is cosmetic — linting works —
# and typescript-eslint has not yet published a release that widens the peer range
# to TS 6. Relax peer resolution until it does; drop this file once typescript-eslint
# accepts TypeScript 6 in its peer deps.
legacy-peer-deps=true
