# The @tiptap packages are at two versions: @tiptap/core 3.30.5 declares the peer
# @tiptap/pm 3.30.5, while @tiptap/pm and the other @tiptap packages are at 3.27.1, whose
# extensions declare @tiptap/pm 3.27.1 and @tiptap/core 3.27.1. Strict peer resolution refuses
# that tree; the editor works with it. Relax peer resolution until the @tiptap packages are at one
# version, then drop this file (with them aligned, `npm install --legacy-peer-deps=false` resolves
# the tree).
legacy-peer-deps=true
