{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(claude mcp list)",
      "Bash(claude mcp get *)",
      "Bash(claude mcp --help)",
      "Bash(npm view *)",
      "Write(//tmp/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NoLogo -NonInteractive -Command \"[console]::Beep(1000, 300)\"",
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -NoLogo -NonInteractive -Command \"[console]::Beep(600, 500); [console]::Beep(800, 500)\"",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "security-guidance@claude-plugins-official": true
  }
}
